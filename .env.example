# ============================================================
# ChatRoom 环境变量示例
# 使用方法：复制为 .env 并按需填写后使用
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不要提交真实值
# ============================================================

# ---------- MySQL ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=chatroom
MYSQL_PASSWORD=<在此填写数据库密码>
MYSQL_DATABASE=chatroom

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------- SMTP（与 chatroom.conf 的 [smtp] 保持一致） ----------
SMTP_HOST=smtp.qq.com
SMTP_FROM=your_email@example.com
SMTP_AUTH_CODE=<在此填写邮箱授权码>
