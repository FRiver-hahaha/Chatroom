{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build with make",
            "type": "shell",
            "command": "make",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build with gcc",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g",
                "${workspaceFolder}/src/main.c",
                "-o",
                "${workspaceFolder}/build/main",
                "-luring"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"]
        }
    ]
}